# bash completion for machines (LordOS's Machines from the terminal; server/src/cli/machines.c)
# installed as /usr/share/bash-completion/completions/machines by tools/iso/mkdeb.sh
_machines() {
    local cur prev cmd
    cur=${COMP_WORDS[COMP_CWORD]}
    prev=${COMP_WORDS[COMP_CWORD-1]}
    cmd=${COMP_WORDS[1]}
    local IFS=$'\n'
    if [ "$COMP_CWORD" -eq 1 ]; then
        COMPREPLY=($(compgen -W $'list\nstatus\nstart\nopen\nstop\npoweroff\npause\nresume\nsuspend\nreset\nsnapshot\nclone\nset\nhelp' -- "$cur"))
        return
    fi
    if [ "$COMP_CWORD" -eq 2 ]; then
        case $cmd in
            list) COMPREPLY=($(compgen -W '--json' -- "$cur")) ;;
            help) ;;
            *)
                # machine names, quoted for the shell (names may have spaces)
                local n names=()
                while IFS= read -r n; do
                    case ${n,,} in "${cur,,}"*) names+=("$(printf '%q' "$n")") ;; esac
                done < <(machines list --names 2>/dev/null)
                COMPREPLY=("${names[@]}")
                ;;
        esac
        return
    fi
    case $cmd in
        status) COMPREPLY=($(compgen -W '--json' -- "$cur")) ;;
        start) COMPREPLY=($(compgen -W '--no-window' -- "$cur")) ;;
        snapshot) [ "$COMP_CWORD" -eq 3 ] && COMPREPLY=($(compgen -W $'list\ntake\nrevert\ndelete' -- "$cur")) ;;
        clone) [ "$COMP_CWORD" -ge 4 ] && COMPREPLY=($(compgen -W $'--duplicate\n--keep-identity' -- "$cur")) ;;
        set)
            case $prev in
                --network) COMPREPLY=($(compgen -W $'shared\nisolated\nbridged\nhostonly' -- "$cur")) ;;
                --clipboard) COMPREPLY=($(compgen -W $'off\nto-guest\nfrom-guest\nboth' -- "$cur")) ;;
                --graphics) COMPREPLY=($(compgen -W $'2d\n3d' -- "$cur")) ;;
                --gpu) COMPREPLY=($(compgen -W $'none\nintel-whole\nintel-shared' -- "$cur")) ;;
                --display) COMPREPLY=($(compgen -W $'window\nnone' -- "$cur")) ;;
                --pointer) COMPREPLY=($(compgen -W $'lordos\nguest' -- "$cur")) ;;
                --iso) COMPREPLY=($(compgen -f -- "$cur")) ;;
                --clipboard-ask|--boot-menu|--sound|--microphone|--agent|--transfer) COMPREPLY=($(compgen -W $'on\noff' -- "$cur")) ;;
                --memory|--cpus|--disk|--name|--bridge|--port|--share|--volume|--boot-order|--resolution|--sound-out|--sound-in|--nic-model|--devices|--ports|--shares) ;;
                *) COMPREPLY=($(compgen -W $'--memory\n--cpus\n--disk\n--name\n--network\n--bridge\n--clipboard\n--clipboard-ask\n--graphics\n--gpu\n--iso\n--display\n--port\n--ports\n--share\n--shares\n--sound\n--volume\n--microphone\n--sound-out\n--sound-in\n--agent\n--transfer\n--boot-order\n--boot-menu\n--resolution\n--pointer\n--devices\n--nic-model' -- "$cur")) ;;
            esac
            ;;
    esac
}
complete -F _machines machines
