{
  "name": "Workspaces",
  "description": "Activities with their own apps and layouts, a Context Spine, tiling per display and three effects styles.",
  "author": "Federico Pereira",
  "email": "fpereira@iperfex.com",
  "organization": "IPERFEX",
  "license": "MIT",
  "sketch": { "rail": true, "pills": true, "frame": true },
  "desktopArrows": true,
  "displayApps": true,
  "wallpaper": { "default": "cyberpunk-panorama", "slideshow": true },
  "options": [
    { "key": "surface", "label": "shell.ws.surface.title", "hint": "shell.ws.opt.surfaceHint", "default": "crystal",
      "choices": [["opaque", "shell.ws.surface.opaque"], ["translucent", "shell.ws.surface.translucent"], ["crystal", "shell.ws.surface.crystal"]] },
    { "key": "spine", "label": "shell.ws.opt.spine", "default": "auto",
      "choices": [["auto", "shell.ws.opt.spineAuto"], ["expanded", "shell.ws.opt.spineExpanded"], ["collapsed", "shell.ws.opt.spineCollapsed"]] },
    { "key": "spineEvery", "label": "shell.ws.opt.spineEvery", "hint": "shell.ws.opt.spineEveryHint", "toggle": true, "default": false },
    { "key": "contrast", "label": "shell.ws.opt.contrast", "hint": "shell.ws.opt.contrastHint", "toggle": true, "default": false }
  ]
}
