      "id": "llama.cpp",
      "package": "llama.cpp",
      "name": "llama.cpp",
      "keywords": ["llama", "llm", "gguf", "local ai", "llama-server"],
      "summary": {
        "en": "Run GGUF language models locally on the CPU or a Vulkan GPU: llama-cli, llama-server and tools",
        "es": "Ejecuta modelos de lenguaje GGUF en tu equipo, en la CPU o una GPU Vulkan: llama-cli, llama-server y herramientas",
        "pt": "Execute modelos de linguagem GGUF no seu computador, na CPU ou numa GPU Vulkan: llama-cli, llama-server e ferramentas"
      },
      "license": "MIT",
      "vendor": "ggml.ai (ggml-org)",
      "homepage": "https://github.com/ggml-org/llama.cpp",
      "arches": [
        "amd64",
        "arm64"
      ],
      "kind": "local-models",
      "source": {
        "type": "build",
        "recipe": "llama.cpp",
        "version": "0.7.0",
        "revision": "1lordos1",
        "source_date_epoch": 1792084399,
        "tag": "v0.7.0",
        "commit": "620d2225cc436ab0b001e3200e590e3b286ef9ab",
        "build_number": 11669,
        "url": "https://github.com/ggml-org/llama.cpp/archive/refs/tags/v0.7.0.tar.gz",
        "sha256": "55d67acf3ad2ad747a9bbeb75f9f0e173dbcc0d1753a471038a90c819421c5e1",
        "inputs": [
          {
            "name": "llama-ui.tar.gz",
            "url": "https://github.com/ggml-org/llama.cpp/releases/download/b11669/llama-b11669-ui.tar.gz",
            "sha256": "cce039b1e0941f069263e37b794648998524d84047ab7ee746f3c686a5cee259"
          }
        ],
        "notes": {
          "amd64": "GGML_NATIVE=OFF with GGML_BACKEND_DL and GGML_CPU_ALL_VARIANTS: every x86-64 CPU variant is built and the best one is loaded at run time from /usr/lib/llama.cpp; GGML_VULKAN=ON adds libggml-vulkan.so, loaded only when a Vulkan device exists. LLAMA_OPENSSL=ON, so -hf downloads models from Hugging Face over HTTPS. llama-server embeds upstream's prebuilt web UI of the same commit (b11669). Built with no network.",
          "arm64": "Same as amd64, with the armv8.0 to armv9.2 CPU variants and the Vulkan backend. Built natively in a debian:trixie arm64 container (qemu on the Mac)."
        }
      }
    },
