{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LordOS Imager",
  "version": "0.8.6",
  "identifier": "org.lordos.imager",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LordOS Imager",
        "width": 980,
        "height": 680,
        "minWidth": 840,
        "minHeight": 580,
        "resizable": true,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "appimage", "nsis"],
    "category": "Utility",
    "shortDescription": "Write LordOS to SD cards and USB sticks",
    "longDescription": "Writes LordOS to SD cards and USB sticks, checks the release signature and reads the drive back, and prepares the Raspberry Pi's first boot.",
    "copyright": "Copyright © 2026 iPERFEX",
    "license": "MIT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" },
    "linux": { "deb": { "depends": ["udisks2"] } }
  }
}
