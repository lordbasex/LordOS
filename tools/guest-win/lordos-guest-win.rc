/* lordos-guest-win: its manifest and version (tools/guest-win/lordos-guest-win.c) */
#include <winver.h>
1 24 "lordos-guest-win.manifest"
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "LordOS"
      VALUE "FileDescription", "LordOS guest tools"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", "lordos-guest-win"
      VALUE "OriginalFilename", "lordos-guest-win.exe"
      VALUE "ProductName", "LordOS"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
