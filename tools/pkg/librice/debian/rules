#!/usr/bin/make -f
# librice for LordOS (docs/WPEWEBKIT.md, "librice"): rice-proto and rice-io built with cargo-c into C libraries,
# offline, from upstream's tag and the crates its Cargo.lock pins (the vendor component tarball, checked by cargo
# against the lock file's checksums).
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
include /usr/share/dpkg/architecture.mk
include /usr/share/dpkg/buildflags.mk
include /usr/share/dpkg/pkg-info.mk

export CARGO_HOME = $(CURDIR)/debian/cargo-home
export CARGO_NET_OFFLINE = true
export CARGO_TARGET_DIR = $(CURDIR)/target
# reproducible: no build path in the binaries, the release profile's own settings otherwise
export RUSTFLAGS = --remap-path-prefix=$(CURDIR)=/usr/src/librice-$(DEB_VERSION_UPSTREAM) --remap-path-prefix=$(CARGO_HOME)=/usr/share/cargo -C link-arg=-Wl,-z,relro,-z,now
JOBS := $(patsubst parallel=%,%,$(filter parallel=%,$(DEB_BUILD_OPTIONS)))
CAPI := --release --frozen --offline --prefix=/usr --libdir=/usr/lib/$(DEB_HOST_MULTIARCH) $(if $(JOBS),-j$(JOBS))
# rice-proto: the C API, and TURN over TLS through the system's OpenSSL (not rustls: no second TLS stack)
PROTO := -p rice-proto --no-default-features --features capi,openssl
IO := -p rice-io --features capi

%:
	dh $@

override_dh_auto_configure:
	mkdir -p $(CARGO_HOME)
	printf '[source.crates-io]\nreplace-with = "vendored-sources"\n\n[source.vendored-sources]\ndirectory = "%s/vendor"\n\n[net]\noffline = true\n' "$(CURDIR)" > $(CARGO_HOME)/config.toml

override_dh_auto_build:
	cargo cbuild $(CAPI) $(PROTO)
	cargo cbuild $(CAPI) $(IO)

override_dh_auto_install:
	cargo cinstall $(CAPI) $(PROTO) --destdir=$(CURDIR)/debian/tmp
	cargo cinstall $(CAPI) $(IO) --destdir=$(CURDIR)/debian/tmp
	# shared libraries only
	rm -f debian/tmp/usr/lib/$(DEB_HOST_MULTIARCH)/*.a

# upstream's tests need the workspace's dev-dependencies and a network; the build's own test is LordOS's
# (tools/pkg/librice-chroot.sh: pkg-config, a C program against both libraries)
override_dh_auto_test:

override_dh_auto_clean:
	rm -rf target debian/cargo-home
