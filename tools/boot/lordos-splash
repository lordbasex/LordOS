#!/bin/sh
# lordos-splash: hands the boot splash (Plymouth) over to LordOS without a black or text flash.
# See docs/SESSIONS.md, "Boot splash".
#
#   lordos-splash deactivate   (lordos.service, the last ExecStartPre) Plymouth stops drawing and
#                              drops DRM master but leaves its last frame on the screen, so
#                              lord-sessiond can take the card.
#   lordos-splash quit         (lordos-splash-quit.service) waits for the first LordOS frame on the
#                              monitor (/run/lordos/first-frame, created by lord-sessiond), then ends
#                              Plymouth keeping that frame (--retain-splash). After 35 s without it,
#                              Plymouth is ended anyway. With /run/lordos/no-display nothing will
#                              replace the splash: it ends without keeping its frame, so the console
#                              and lord-sessiond's message on it show.
# Without Plymouth (not installed, or not running) both do nothing.
set -u
PLY=/usr/bin/plymouth
[ -x "$PLY" ] || exit 0
"$PLY" --ping 2>/dev/null || exit 0
case "${1:-}" in
    deactivate)
        exec "$PLY" deactivate
        ;;
    quit)
        i=0
        # longer than lord-sessiond's 30 s for a late display driver, so this can tell which case it is
        while [ $i -lt 350 ] && [ ! -e /run/lordos/first-frame ]; do
            sleep 0.1
            i=$((i + 1))
        done
        [ -e /run/lordos/first-frame ] || echo "lordos-splash: no LordOS frame after 35 s; ending the splash" >&2
        if [ -e /run/lordos/no-display ]; then
            echo "lordos-splash: no usable display; ending the splash for the text console" >&2
            exec "$PLY" quit
        fi
        exec "$PLY" quit --retain-splash
        ;;
    *)
        echo "usage: lordos-splash deactivate|quit" >&2
        exit 2
        ;;
esac
