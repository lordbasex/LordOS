# lordos-user.txt — the first-boot user of LordOS on the Raspberry Pi (docs/RASPBERRY.md).
# Copy this file as «lordos-user.txt» onto this same partition (bootfs) before the first
# boot. It is read only once, validated with the installer's rules and DELETED.
# Without this file (or a userconf.txt from Raspberry Pi Imager), LordOS enters setup
# mode: create the account in Settings → Users and reboot.
#
# User: lowercase letters, digits, _ and -, starting with a letter or _ (32 max).
user=ana
fullname=Ana Pérez
# A hash is better than the plain-text password. On Linux: `mkpasswd -m yescrypt` (whois package) or
# `openssl passwd -6`. If password= is used, it sits in plain text on the card until first boot.
password_hash=$y$j9T$REEMPLAZAR$REEMPLAZAR
#password=
hostname=ana-pi
# es, en, pt, fr or it
lang=en
timezone=America/Argentina/Buenos_Aires
keyboard=latam
keyboard_variant=
# Wi-Fi (optional): saved like Settings → Network does, joined at boot. Leave wifi_password empty
# for an open network. wifi_country (two letters) unlocks the country's 5 GHz channels from the
# second boot on. Without Wi-Fi, plug in an Ethernet cable (DHCP).
#wifi_ssid=MyNetwork
#wifi_password=
#wifi_country=AR
#
# Remote desktop and SSH are not set here: create an empty file named «remote-desktop» (and/or
# «ssh») on this partition. See docs/RASPBERRY.md, "Switch files".
