#!/bin/sh
# firstboot — LordOS on Raspberry Pi, before lord-sessiond (lordos-rpi-firstboot.service).
# See docs/RASPBERRY.md, "First boot".
#
# 1. First boot: grows the system partition (number 2) to the end of the SD card or NVMe.
# 2. First boot: the user.
#    0) If the boot partition has a lordos-firstrun.txt (written by the LordOS Imager,
#       docs/IMAGER.md), /usr/lib/lordos/bin/lordos-firstrun validates it strictly and applies it
#       once (computer name, language, time zone, keyboard, Wi-Fi, user, SSH, remote desktop,
#       Bluetooth, appearance, cooling), then shreds it. If it is invalid, nothing of it is applied
#       and the steps below run as if it weren't there.
#    a) If the boot partition (/boot/firmware) has a lordos-user.txt (or the userconf.txt
#       from Raspberry Pi Imager / Raspberry Pi OS: «user:hash»), that user is created with the same
#       rules as the installer's «User» step (docs/ISO.md, install.c) and the file is deleted.
#       Login goes through the login screen (empty AUTOLOGIN=), like an installed system.
#    b) Otherwise, setup mode: logs in automatically as the `lordos` user (no password, passwordless
#       sudo, same as the live ISO) and the person's own account must be created in Settings → Users
#       (as administrator). While it lasts, remote desktop must stay off.
# 3. On every boot in setup mode: if there is already a person administrator account
#    besides `lordos`, `lordos` (and its passwordless sudo) is removed and the system switches to the
#    login screen.
# 4. On every boot: the switch files on the boot partition, like Raspberry Pi OS's `ssh` file.
#    Each one is applied, logged and deleted (docs/RASPBERRY.md, "Switch files"):
#    - `ssh` (or `ssh.txt`): turns the SSH server on (if the image ships it) and keeps it on.
#    - `remote-desktop` (or `remote-desktop.txt`; empty, or `port=<1024..65535>` and/or
#      `allow=all|group`): turns LordOS remote desktop on, in the same file Settings → Sharing
#      writes (/etc/lordos/remote/config, read by lord-sessiond when lordos.service starts).
#      Logging in still needs an account with a password: while there is none (setup mode) the
#      file is kept and applied on a later boot.
#    Every boot also creates missing SSH host keys (the image ships none).
set -u
STATE=/var/lib/lordos/rpi
BOOT=/boot/firmware
CONF=/etc/lordos/session.conf
SETUP_USER=lordos
log() { echo "lordos-rpi: $*"; }

mkdir -p "$STATE"

# ---- 1. grow the system partition ----
if [ -e "$STATE/resize-pending" ]; then
    ROOTDEV=$(findmnt -n -o SOURCE /)
    DISK=/dev/$(lsblk -n -o PKNAME "$ROOTDEV" | head -1)
    PART=$(cat "/sys/class/block/$(basename "$ROOTDEV")/partition" 2>/dev/null || echo 2)
    if [ -b "$DISK" ] && [ "$PART" = 2 ]; then
        log "growing $ROOTDEV to the end of $DISK"
        echo ", +" | sfdisk --force --no-reread --no-tell-kernel -N 2 "$DISK" >/dev/null 2>&1 || log "sfdisk failed"
        partx -u -n 2 "$DISK" 2>/dev/null || true
        resize2fs "$ROOTDEV" >/dev/null 2>&1 || log "resize2fs failed (retrying on next boot)"
        # only once the file system fills the partition
        PSIZE=$(blockdev --getsize64 "$ROOTDEV" 2>/dev/null || echo 0)
        FSIZE=$(df -B1 --output=size / | tail -1 | tr -d ' ')
        [ "$PSIZE" -gt 0 ] && [ $((FSIZE * 100 / PSIZE)) -ge 90 ] && rm -f "$STATE/resize-pending"
    else
        log "system partition not recognized ($ROOTDEV), not growing it"
        rm -f "$STATE/resize-pending"
    fi
fi

# ---- validation (same rules as install.c) ----
valid_user() {
    echo "$1" | grep -Eq '^[a-z_][a-z0-9_-]{0,31}$' || return 1
    case "$1" in root|daemon|bin|sys|sync|games|man|lp|mail|news|uucp|proxy|www-data|backup|list|irc|nobody|lordos|lordos-greeter|systemd-*|messagebus|polkitd|sshd) return 1 ;; esac
    ! getent passwd "$1" >/dev/null
}
valid_host() { echo "$1" | grep -Eq '^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$'; }
valid_hash() { echo "$1" | grep -Eq '^\$(y|6|5|2b)\$[A-Za-z0-9./$]{8,250}$'; }
valid_tz() { case "$1" in *..*|/*|'') return 1 ;; esac; [ -f "/usr/share/zoneinfo/$1" ]; }
valid_layout() { echo "$1" | grep -Eq '^[a-z]{2,10}$' && [ -f "/usr/share/X11/xkb/symbols/$1" ]; }
valid_variant() { echo "$1" | grep -Eq '^[A-Za-z0-9_-]{0,32}$'; }
kv() { sed -n "s/^$1=//p" "$2" | head -1 | tr -d '\r'; }

person_admins() {     # person accounts (uid 1000–59999) in the sudo group, excluding the setup one
    getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 { print $1 }' | while read -r u; do
        [ "$u" = "$SETUP_USER" ] && continue
        id -nG "$u" 2>/dev/null | tr ' ' '\n' | grep -qx sudo && echo "$u"
    done
}

set_conf() {          # AUTOLOGIN=<value> in session.conf, without touching other lines
    mkdir -p /etc/lordos
    if [ -f "$CONF" ] && grep -q '^AUTOLOGIN=' "$CONF"; then sed -i "s/^AUTOLOGIN=.*/AUTOLOGIN=$1/" "$CONF"
    else echo "AUTOLOGIN=$1" >> "$CONF"; fi
}

drop_setup_user() {
    getent passwd "$SETUP_USER" >/dev/null || return 0
    log "removing the setup user $SETUP_USER"
    pkill -KILL -u "$SETUP_USER" 2>/dev/null || true
    rm -f /etc/sudoers.d/lordos-setup "/var/lib/systemd/linger/$SETUP_USER"
    userdel -r "$SETUP_USER" 2>/dev/null || userdel "$SETUP_USER" 2>/dev/null || true
}

user_dirs() {         # user folders by language, like Settings' user-add
    case "$2" in
        en) set -- "$1" Desktop Documents Downloads Music Pictures Videos ;;
        pt) set -- "$1" "Área de trabalho" Documentos Downloads Música Imagens Vídeos ;;
        *)  set -- "$1" Escritorio Documentos Descargas Música Imágenes Videos ;;
    esac
    u=$1; shift
    h=$(getent passwd "$u" | cut -d: -f6)
    for d in "$@"; do install -d -o "$u" -g "$u" "$h/$d"; done
}

# ---- Wi-Fi from lordos-user.txt (wifi_ssid=, wifi_password=, wifi_country=) ----
# Saved exactly as Settings → Network saves a network (lord-netd, server/src/net/wifi.c):
# /etc/lordos/net/wifi/<ssid in hex>.json (public) and <ssid in hex>.key (0600). lord-netd loads the
# saved networks into wpa_supplicant when it brings Wi-Fi up at boot (DHCP, no NetworkManager).
NET_WIFI=/etc/lordos/net/wifi
json_esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
wifi_from() {
    WS=$(kv wifi_ssid "$1"); WP=$(kv wifi_password "$1"); WC=$(kv wifi_country "$1")
    [ -n "$WS" ] || return 0
    WL=$(printf '%s' "$WS" | wc -c); PL=$(printf '%s' "$WP" | wc -c)
    if [ "$WL" -gt 32 ] || printf '%s' "$WS" | LC_ALL=C grep -q '[[:cntrl:]]'; then
        log "$(basename "$1"): wifi_ssid is longer than 32 bytes or has control characters: Wi-Fi not saved"
    elif [ -n "$WP" ] && { [ "$PL" -lt 8 ] || [ "$PL" -gt 128 ] || printf '%s' "$WP" | LC_ALL=C grep -q '[[:cntrl:]]'; }; then
        log "$(basename "$1"): wifi_password must be 8–128 characters: Wi-Fi not saved"
    else
        SH=$(printf '%s' "$WS" | od -An -v -tx1 | tr -d ' \n')
        install -d -m 755 /etc/lordos/net "$NET_WIFI"
        if [ -n "$WP" ]; then SEC=psk; else SEC=open; fi
        printf '{"ssid":"%s","security":"%s"}\n' "$(json_esc "$WS")" "$SEC" > "$NET_WIFI/$SH.json"
        chmod 644 "$NET_WIFI/$SH.json"
        (umask 077; printf 'pass=%s\n' "$WP" > "$NET_WIFI/$SH.key")
        log "Wi-Fi network saved: $WS ($SEC)"
    fi
    # regulatory domain (5 GHz channels): kernel option, takes effect from the next boot
    if [ -n "$WC" ]; then
        WC=$(echo "$WC" | tr '[:lower:]' '[:upper:]')
        if echo "$WC" | grep -Eq '^[A-Z]{2}$' && [ -f "$BOOT/cmdline.txt" ]; then
            sed -i -e 's/ *cfg80211\.ieee80211_regdom=[A-Z0-9]*//g' -e "1s/\$/ cfg80211.ieee80211_regdom=$WC/" "$BOOT/cmdline.txt"
            log "Wi-Fi country $WC (cmdline.txt, from the next boot)"
        else
            log "$(basename "$1"): wifi_country must be a two-letter code (AR, US, DE…)"
        fi
    fi
}

# ---- 2. first boot: the LordOS Imager's first-run file, then the user ----
FIRSTRUN=/usr/lib/lordos/bin/lordos-firstrun
if [ -e "$STATE/firstboot-pending" ] && [ -f "$BOOT/lordos-firstrun.txt" ]; then
    if [ -x "$FIRSTRUN" ]; then
        log "applying lordos-firstrun.txt (LordOS Imager)"
        "$FIRSTRUN" apply "$BOOT/lordos-firstrun.txt"
        RC=$?
    else
        log "lordos-firstrun.txt found but this image has no lordos-firstrun: ignored"
        RC=1
    fi
    # it is shredded by lordos-firstrun; never leave it behind
    [ -e "$BOOT/lordos-firstrun.txt" ] && { dd if=/dev/zero of="$BOOT/lordos-firstrun.txt" bs=1 count="$(stat -c %s "$BOOT/lordos-firstrun.txt")" conv=notrunc 2>/dev/null; rm -f "$BOOT/lordos-firstrun.txt"; }
    if [ "$RC" = 0 ]; then
        # the account exists (and session.conf says whether it logs in automatically)
        drop_setup_user
        rm -f "$STATE/setup-mode" "$STATE/firstboot-pending"
        rm -f "$BOOT/lordos-user.txt" "$BOOT/userconf.txt"
        sync
    fi
fi
if [ -e "$STATE/firstboot-pending" ]; then
    F=""
    [ -f "$BOOT/lordos-user.txt" ] && F="$BOOT/lordos-user.txt"
    LANG_UI=en     # English by default, like the ISO
    for a in $(cat /proc/cmdline); do case "$a" in lordos.lang=es) LANG_UI=es ;; lordos.lang=pt) LANG_UI=pt ;; esac; done
    U=""; FULL=""; HASH=""; PASS=""; HOST=""; TZ_=""; KB=""; KBV=""
    if [ -n "$F" ]; then
        U=$(kv user "$F"); FULL=$(kv fullname "$F" | tr -d ':,' | tr -d '\000-\037')
        HASH=$(kv password_hash "$F"); PASS=$(kv password "$F"); HOST=$(kv hostname "$F")
        L=$(kv lang "$F"); case "$L" in es|en|pt) LANG_UI=$L ;; esac
        TZ_=$(kv timezone "$F"); KB=$(kv keyboard "$F"); KBV=$(kv keyboard_variant "$F")
        wifi_from "$F"
    elif [ -f "$BOOT/userconf.txt" ]; then
        F="$BOOT/userconf.txt"
        LINE=$(head -1 "$F" | tr -d '\r')
        U=${LINE%%:*}; HASH=${LINE#*:}
    fi
    OK=0
    if [ -n "$F" ]; then
        if ! valid_user "$U"; then log "$F: invalid user or already exists ($U)"
        elif [ -n "$HASH" ] && ! valid_hash "$HASH"; then log "$F: password_hash is not a crypt(3) hash (\$y\$, \$6\$…)"
        elif [ -z "$HASH" ] && [ -z "$PASS" ]; then log "$F: missing password"
        else OK=1; fi
    fi
    if [ "$OK" = 1 ]; then
        log "creating user $U (from $(basename "$F"))"
        # lpadmin: an administrator manages printers too (CUPS, docs/PRINTING.md), as on the ISO
        GROUPS_U=sudo,audio,video,input,render
        for g in lpadmin plugdev; do getent group "$g" > /dev/null && GROUPS_U="$GROUPS_U,$g"; done
        useradd --create-home --shell /bin/bash --user-group --comment "${FULL:-$U}" -G "$GROUPS_U" "$U"
        if [ -n "$HASH" ]; then usermod -p "$HASH" "$U"
        else printf '%s:%s\n' "$U" "$PASS" | chpasswd; fi       # chpasswd: yescrypt, like Debian
        : > "/var/lib/systemd/linger/$U"
        user_dirs "$U" "$LANG_UI"
        case "$LANG_UI" in es) LOC=es_ES.UTF-8 ;; pt) LOC=pt_BR.UTF-8 ;; *) LOC=en_US.UTF-8 ;; esac
        printf 'LANG=%s\n' "$LOC" > /etc/default/locale
        H=$(getent passwd "$U" | cut -d: -f6)
        install -d -o "$U" -g "$U" "$H/.config" "$H/.config/lordos"
        if [ -n "$KB" ] && valid_layout "$KB" && valid_variant "$KBV"; then
            printf '{\n  "language": "%s",\n  "keyboards": [{ "layout": "%s", "variant": "%s" }],\n  "keyboardIndex": 0\n}\n' "$LANG_UI" "$KB" "$KBV" > "$H/.config/lordos/settings.json"
            printf 'XKBMODEL="pc105"\nXKBLAYOUT="%s"\nXKBVARIANT="%s"\nXKBOPTIONS=""\nBACKSPACE="guess"\n' "$KB" "$KBV" > /etc/default/keyboard
        else
            printf '{\n  "language": "%s"\n}\n' "$LANG_UI" > "$H/.config/lordos/settings.json"
        fi
        printf 'LANG=%s\n' "$LOC" > "$H/.config/locale.conf"
        chown "$U:$U" "$H/.config/lordos/settings.json" "$H/.config/locale.conf"
        if [ -n "$TZ_" ] && valid_tz "$TZ_"; then ln -sf "/usr/share/zoneinfo/$TZ_" /etc/localtime; echo "$TZ_" > /etc/timezone; fi
        if [ -n "$HOST" ] && valid_host "$HOST"; then
            echo "$HOST" > /etc/hostname; hostname "$HOST" 2>/dev/null || true
            sed -i "s/^127\.0\.1\.1\s.*/127.0.1.1\t$HOST/" /etc/hosts
        fi
        drop_setup_user
        set_conf ""
        rm -f "$STATE/setup-mode"
    else
        log "no valid lordos-user.txt or userconf.txt: setup mode (logs in as $SETUP_USER; create the account in Settings → Users)"
        set_conf "$SETUP_USER"
        : > "$STATE/setup-mode"
    fi
    # the password does not stay on the FAT partition (readable by anyone holding the card)
    if [ -n "$F" ]; then
        dd if=/dev/zero of="$F" bs=1 count="$(stat -c %s "$F")" conv=notrunc 2>/dev/null || true
        rm -f "$F"
    fi
    rm -f "$STATE/firstboot-pending"
    sync
fi

# ---- 3. leave setup mode ----
if [ -e "$STATE/setup-mode" ]; then
    A=$(person_admins | head -1)
    if [ -n "$A" ]; then
        log "administrator $A already exists: end of setup mode"
        drop_setup_user
        # if Settings → Users chose automatic login with another account, keep it
        grep -q "^AUTOLOGIN=$SETUP_USER\$" "$CONF" 2>/dev/null && set_conf ""
        rm -f "$STATE/setup-mode"
    fi
fi

# ---- 4. switch files on the boot partition ----
# SSH host keys: the image ships none (each board gets its own); created on the first boot that
# has the SSH server installed.
if [ -x /usr/sbin/sshd ] && ! ls /etc/ssh/ssh_host_*_key >/dev/null 2>&1; then
    if ssh-keygen -A >/dev/null 2>&1; then log "SSH host keys created"; else log "ssh-keygen -A failed"; fi
fi

consume() {           # overwrites and deletes a switch file (it can hold a password)
    dd if=/dev/zero of="$1" bs=1 count="$(stat -c %s "$1")" conv=notrunc 2>/dev/null || true
    rm -f "$1"
    sync
}

for S in "$BOOT/ssh" "$BOOT/ssh.txt"; do
    [ -e "$S" ] || continue
    if [ -x /usr/sbin/sshd ]; then
        # enable for the following boots; --no-block: this unit runs inside the boot transaction
        systemctl enable ssh.service >/dev/null 2>&1 || true
        systemctl start --no-block ssh.service >/dev/null 2>&1 || true
        log "$(basename "$S"): SSH server turned on (password logins need an account with a password; root is locked)"
    else
        log "$(basename "$S"): this image has no SSH server (openssh-server): ignored"
    fi
    consume "$S"
done

has_login_account() { # a person account (uid 1000–59999) with a real password: remote login refuses the rest
    getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 { print $1 }' | while read -r u; do
        [ "$u" = "$SETUP_USER" ] && continue
        getent shadow "$u" | cut -d: -f2 | grep -q '^\$' && echo "$u"
    done | grep -q .
}

RD_DIR=/etc/lordos/remote
for S in "$BOOT/remote-desktop" "$BOOT/remote-desktop.txt"; do
    [ -e "$S" ] || continue
    N=$(basename "$S")
    if [ -e "$STATE/setup-mode" ] || ! has_login_account; then
        log "$N: kept until an account with a password exists (lordos-user.txt, or Settings → Users and a reboot)"
        continue
    fi
    # the current values (Settings → Sharing may have saved some), then the file's
    PORT=5673; ALLOW=all; DEV=0
    if [ -f "$RD_DIR/config" ]; then
        v=$(kv port "$RD_DIR/config"); [ -n "$v" ] && PORT=$v
        v=$(kv allow "$RD_DIR/config"); [ "$v" = group ] && ALLOW=group
        v=$(kv insecure_dev "$RD_DIR/config"); [ "$v" = 1 ] && DEV=1
    fi
    v=$(kv port "$S")
    if [ -n "$v" ]; then
        if echo "$v" | grep -Eq '^[0-9]{4,5}$' && [ "$v" -ge 1024 ] && [ "$v" -le 65535 ]; then PORT=$v
        else log "$N: port=$v is not 1024–65535: using $PORT"; fi
    fi
    v=$(kv allow "$S")
    case "$v" in
        '') ;;
        all|group) ALLOW=$v ;;
        *) log "$N: allow=$v is not all or group: using $ALLOW" ;;
    esac
    if [ "$ALLOW" = group ] && ! getent group lordos-remote >/dev/null; then
        groupadd --system lordos-remote 2>/dev/null || true
    fi
    install -d -m 755 /etc/lordos "$RD_DIR"
    # the same file and format as remote-enable/remote-config (server/src/remote/remote_admin.c)
    printf '# LordOS · remote desktop (Settings → Sharing). See docs/REMOTE.md\nenabled=1\nport=%s\nallow=%s\ninsecure_dev=%s\n' \
        "$PORT" "$ALLOW" "$DEV" > "$RD_DIR/config.lordos"
    chmod 644 "$RD_DIR/config.lordos"
    mv -f "$RD_DIR/config.lordos" "$RD_DIR/config"
    log "$N: remote desktop on, port $PORT, allow=$ALLOW (https://<this board's IP>:$PORT; log in with your account)"
    consume "$S"
done
exit 0
