[Desktop Entry]
# "Send to LordOS" in Dolphin's context menu (KDE service menu; docs/VIRTUALIZATION.md 6.21). Installed with lordos-guest
# (tools 10) as /usr/local/share/kio/servicemenus/lordos-send-to-host.desktop (or /usr/share/kio/servicemenus by the
# lordos package), mode 0755 (Plasma 6 runs only executable service menus outside the system's own folders).
Type=Service
MimeType=application/octet-stream;
Actions=sendToLordOS
X-KDE-Priority=TopLevel

[Desktop Action sendToLordOS]
Name=Send to LordOS
Icon=document-send
Exec=lordos-guest --send-to-host %F
